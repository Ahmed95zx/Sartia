<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>sartia</groupId>
  <artifactId>sartia</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>

  <name>Sartia - Video Rental System</name>
  <description>Video/DVD rental system built with JSF, JDBC and JAX-RS</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <jakartaee.version>10.0.0</jakartaee.version>
    <mysql.version>8.4.0</mysql.version>
    <hikari.version>5.1.0</hikari.version>
    <junit.version>5.10.2</junit.version>
    <payara.version>6.2024.6</payara.version>

    <!-- Integration tests run against their OWN throwaway schema, never the
         application's `sartia` database, so a test run can never leave films
         like "admin return <n>" in the real catalogue. Override on the command
         line to point elsewhere, e.g.
             mvn verify -Dtest.db.url=jdbc:mysql://127.0.0.1:3306/other -->
    <test.db.url>jdbc:mysql://127.0.0.1:3306/sartia_test?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Jerusalem&amp;characterEncoding=UTF-8</test.db.url>
    <test.db.user>root</test.db.user>
    <test.db.password>ahmed1995</test.db.password>
  </properties>

  <dependencies>
    <!-- Jakarta EE 10 Web Profile: Faces (JSF), CDI, JAX-RS, Servlet, Bean Validation.
         Scope "provided" - the API is supplied by the application server at runtime. -->
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-web-api</artifactId>
      <version>${jakartaee.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- JDBC driver for MySQL. -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${mysql.version}</version>
    </dependency>

    <!-- JDBC connection pool. A pool is required because opening a TCP connection
         and authenticating per request does not hold up under concurrent load. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
      <version>${hikari.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>sartia</finalName>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <!-- Unit tests only. The integration tests (*IT.java) talk to a
                 real MySQL database, so they run under the failsafe plugin
                 below (the `mvn verify` phase) against a throwaway schema,
                 rather than here in `mvn test` against the live one. -->
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Integration tests: the concurrency guarantee they check is the
           project's central correctness claim, so `mvn verify` must run them.
           They need MySQL running with the schema applied - provision the
           throwaway schema once with:
               mysql -u root -p < scripts/setup-test-db.sql
           `systemPropertyVariables` below are passed to the forked test JVM and
           override the db.* keys in sartia.properties (Database.resolve()
           consults System properties first), so the tests connect to
           sartia_test and never to the application's `sartia` database. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <db.url>${test.db.url}</db.url>
            <db.user>${test.db.user}</db.user>
            <db.password>${test.db.password}</db.password>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Runs the packaged WAR on an embedded Payara Micro server:
           mvn payara-micro:start -->
      <plugin>
        <groupId>fish.payara.maven.plugins</groupId>
        <artifactId>payara-micro-maven-plugin</artifactId>
        <version>2.4</version>
        <configuration>
          <payaraVersion>${payara.version}</payaraVersion>
          <deployWar>true</deployWar>
          <commandLineOptions>
            <option>
              <key>--port</key>
              <value>8080</value>
            </option>
            <option>
              <key>--contextroot</key>
              <value>/sartia</value>
            </option>
          </commandLineOptions>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
