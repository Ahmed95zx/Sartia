<?xml version="1.0" encoding="UTF-8"?>
<!--
  CDI configuration.

  bean-discovery-mode="annotated" registers only classes carrying a bean
  defining annotation (@ApplicationScoped, @ViewScoped, @RequestScoped, ...).
  The DAOs are deliberately left out: they are stateless helpers created
  directly by the services, not injectable beans.
-->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
</beans>
